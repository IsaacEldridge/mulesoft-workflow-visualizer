# =============================================================================
# CX AI Content Workbench - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials
# Command: cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Salesforce/MuleSoft Team Configuration (INTERNAL USE)
# -----------------------------------------------------------------------------
# This configuration uses the Salesforce internal Bedrock proxy

# Salesforce Bedrock Proxy Endpoint (DO NOT CHANGE)
ANTHROPIC_BEDROCK_BASE_URL=https://eng-ai-model-gateway.sfproxy.devx-preprod.aws-esvc1-useast2.aws.sfdc.cl/bedrock

# Your Salesforce API Key/Token
# Contact your team lead for credentials
ANTHROPIC_API_KEY=your_salesforce_api_key_here

# Alternative: If using ANTHROPIC_AUTH_TOKEN instead
# ANTHROPIC_AUTH_TOKEN=your_auth_token_here


# -----------------------------------------------------------------------------
# External/Public Configuration (EXTERNAL USERS)
# -----------------------------------------------------------------------------
# If you're NOT a Salesforce team member, use the public Anthropic API instead
# Uncomment and use this configuration:

# Public Anthropic API (comment out ANTHROPIC_BEDROCK_BASE_URL above)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...


# -----------------------------------------------------------------------------
# Optional Configuration
# -----------------------------------------------------------------------------

# Backend Server Port (default: 3001)
# Change if port 3001 is already in use
# PORT=3001

# Frontend Dev Server Port (managed by Vite, default: 3000)
# To change, edit vite.config.js
